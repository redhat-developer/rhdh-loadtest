FROM mcr.microsoft.com/playwright:v1.65.0-resolute
# Node 26+ images may omit corepack; only disable when present
RUN if command -v corepack >/dev/null 2>&1; then corepack disable; fi
RUN npm install -g yarn

WORKDIR /app
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn .yarn
RUN yarn install --immutable
COPY . .
CMD ["yarn", "test"]
